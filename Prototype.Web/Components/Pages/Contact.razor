@page "/contact"

<div class="content">
    <h2>Contact Us</h2>
    <p>Want to know more? Reach out to us!</p>
    <p>We love to hear from you!!</p>
    <div class="contact-message">
        <h3>Send Message</h3>
        <h4>Full Name</h4>
        <input class="textbox" type="text" placeholder=" Enter your full name" @bind="Name"/>
        <h4>Email</h4>
        <input class="textbox" type="email" placeholder=" Enter your email" @bind-value="Email" />
        <h4>Message</h4>
        <input class="messagebox" type="text" placeholder=" Type your message here" @bind="Message" />
        <button class="button" @onclick="Click">Send</button>
        <p>@Description</p>
    </div>
    <div class="contact-sub-container">
        <div class="contact-heading">
            <svg height="20" width="20">
                <image href="./Images/address.svg" height="20" width="20"></image>
            </svg><h4>Address</h4>
        </div>
        <p>21/floor 2, Blogs main office, Sugar Camp Road, Minnesota, 55060</p>
        <div class="contact-heading">
            <svg height="20" width="20">
                <image href="./Images/phone-call.svg" height="20" width="20"></image>
            </svg><h4>Phone</h4>
        </div>
        <p>987-654-3210</p>
        <div class="contact-heading">
            <svg height="20" width="20">
                <image href="./Images/email.svg" height="20" width="20"></image>
            </svg>
            <h4>Email</h4>
        </div>
        <p>contact@@blogs.com</p>
    </div>
</div>


@code {
    private string Name { get; set; } = string.Empty;
    private string Email { get; set; } = string.Empty;
    private string Message { get; set; } = string.Empty;
    private string Description { get; set; } = string.Empty;
    private void Click()
    {
        Description = "Thanks for your valuable message. We will get back to you soon!";
    }
}
