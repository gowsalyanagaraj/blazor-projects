@page "/edittodo"
@using Prototype.Web.Models
@inject NavigationManager NavigationManager

<main class="add-card">
    <div class="flex-card">
        <h3>Edit Task</h3>
        <input type="text" class="textbox" name="taskinput" @bind="input"/>
        <button class="button" @onclick="Submit">Submit</button>
    </div>
</main>

@code {

    public void Submit()
    {
        ToDoItems.list[ToDoListItem.index].Items = @input;
        NavigationManager.NavigateTo("/");
    }
}